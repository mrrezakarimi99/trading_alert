<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
=============================================================================
LAUNCHD SERVICE FILE - macOS
=============================================================================
File: ~/Library/LaunchAgents/com.crypto.trading.plist

Installation:
1. cp services/com.crypto.trading.plist ~/Library/LaunchAgents/
2. launchctl load ~/Library/LaunchAgents/com.crypto.trading.plist
3. launchctl start com.crypto.trading

Management:
- Status: launchctl list | grep crypto.trading
- Start:  launchctl start com.crypto.trading  
- Stop:   launchctl stop com.crypto.trading
- Logs:   tail -f ~/Library/Logs/crypto-trading.log

Uninstall:
1. launchctl stop com.crypto.trading
2. launchctl unload ~/Library/LaunchAgents/com.crypto.trading.plist
3. rm ~/Library/LaunchAgents/com.crypto.trading.plist
=============================================================================
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.crypto.trading</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/Users/USERNAME/Projects/Test/PredictPrice/.venv/bin/python</string>
        <string>/Users/USERNAME/Projects/Test/PredictPrice/main.py</string>
    </array>
    
    <key>WorkingDirectory</key>
    <string>/Users/USERNAME/Projects/Test/PredictPrice</string>
    
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/USERNAME/Projects/Test/PredictPrice</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    
    <key>RunAtLoad</key>
    <true/>
    
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>
    
    <key>StandardOutPath</key>
    <string>/Users/USERNAME/Projects/Test/PredictPrice/logs/service.log</string>
    
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/Projects/Test/PredictPrice/logs/service-error.log</string>
    
    <key>ProcessType</key>
    <string>Background</string>
    
    <key>Nice</key>
    <integer>10</integer>
    
    <key>StartInterval</key>
    <integer>30</integer>
    
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>